# Connection components. The DSN is composed in app/config.py via
# SQLAlchemy's URL.create(), which escapes the password for you -- do not
# percent-encode it here.
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=medas
DATABASE_NAME=medas
DATABASE_PASSWORD=CHANGE_ME

# Log every statement SQLAlchemy emits.
DB_ECHO=false

# Clerk: the same secret key as medas-ui/.env.local. Verifies session tokens
# and looks up a user's email on their first sign-in.
CLERK_SECRET_KEY=sk_test_...
# Origins a token may be issued for, as a JSON list.
# CLERK_AUTHORIZED_PARTIES=["http://localhost:3000"]
