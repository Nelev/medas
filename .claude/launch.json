{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "medas-api",
      "runtimeExecutable": "uv",
      "runtimeArgs": ["run", "fastapi", "dev", "main.py"],
      "cwd": "medas-api",
      "port": 8000
    },
    {
      "name": "medas-ui",
      "runtimeExecutable": "yarn",
      "runtimeArgs": ["dev"],
      "cwd": "medas-ui",
      "port": 3000
    }
  ]
}
